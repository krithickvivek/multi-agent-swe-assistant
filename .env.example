# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value is read via os.environ - no key is ever hard-coded (hard constraint 6).

# ---- LLM provider keys (free tier only - hard constraint 1) ----
# Leave a key blank if you have not signed up yet; verify_setup.py will SKIP it,
# and llm_client will fail over to the next provider in the chain.
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Database ----
# SQLite locally; set a postgresql+asyncpg:// URL to switch, no code change.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---- LLM response cache (keyed on model + prompt + temperature) ----
LLM_CACHE_PATH=./.cache/llm_cache.db
LLM_CACHE_ENABLED=true

# ---- RAG ----
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Sandbox (hard constraint 2: generated code runs ONLY here) ----
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_NETWORK=none

# ---- Logging ----
LOG_LEVEL=INFO
